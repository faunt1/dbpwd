# Druid Connection Pool Configuration - Template
# Template for: Production PostgreSQL Analytics Database
# Template Name: postgres_prod_analytics
# UID: analytics_prod
# Algorithm: SM4

# Basic Configuration
driverClassName=org.postgresql.Driver
url=jdbc:postgresql://192.168.1.50:5432/analytics
username=analytics_user
password=@config(analytics_prod)

# Connection Pool Configuration
initialSize=5
minIdle=5
maxActive=30
maxWait=60000
timeBetweenEvictionRunsMillis=120000
minEvictableIdleTimeMillis=600000
validationQuery=SELECT 1
testWhileIdle=true
testOnBorrow=false
testOnReturn=false

# Prepared Statement Cache
poolPreparedStatements=true
maxPoolPreparedStatementPerConnectionSize=20

# Connection Recovery
removeAbandoned=true
removeAbandonedTimeout=1800
logAbandoned=true

# Password Decryption Configuration
druid.connectionProperties=config.decrypt=true;config.decrypt.key=@key(analytics_prod_key);config.decrypt.algorithm=SM4
