# Druid Connection Pool Configuration - Template
# Template for: Production MySQL User Database
# Template Name: mysql_prod_userdb
# UID: userdb_prod
# Algorithm: SM4

# Basic Configuration
driverClassName=com.mysql.cj.jdbc.Driver
url=jdbc:mysql://192.168.1.100:3306/userdb?useSSL=false&serverTimezone=UTC
username=root
password=@config(userdb_prod)

# Connection Pool Configuration
initialSize=10
minIdle=10
maxActive=50
maxWait=60000
timeBetweenEvictionRunsMillis=60000
minEvictableIdleTimeMillis=300000
validationQuery=SELECT 1
testWhileIdle=true
testOnBorrow=false
testOnReturn=false

# Prepared Statement Cache
poolPreparedStatements=true
maxPoolPreparedStatementPerConnectionSize=20

# Connection Recovery
removeAbandoned=true
removeAbandonedTimeout=1800
logAbandoned=true

# Password Decryption Configuration
druid.connectionProperties=config.decrypt=true;config.decrypt.key=@key(userdb_prod_key);config.decrypt.algorithm=SM4
