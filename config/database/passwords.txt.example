# Druid Database Password Storage
# Format: uid=encryptedPassword
# Example: uid=[keyLength]Base64(IV+Ciphertext)
#
# Key Length:
# - 16 for SM4 (128-bit)
# - 16/24/32 for AES (128/192/256-bit)
#
# Example passwords (DO NOT USE IN PRODUCTION):
# userdb_prod=[16]ExampleSM4EncryptedPasswordBase64Encoded=
# analytics_prod=[32]ExampleAESEncryptedPasswordBase64EncodedLongerText=
# orderdb_test=[16]AnotherExampleSM4EncryptedPasswordBase64=
#
# To generate encrypted passwords, use:
# java -cp druid-db-pwd.jar com.dbpwd.DruidConfigGeneratorCLI
