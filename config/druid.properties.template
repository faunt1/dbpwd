# Druid JDBC Connection Pool Configuration
# Generated by dbpwd tool

# Basic Configuration
druid.url=jdbc:mysql://localhost:3306/your_database?useSSL=false&serverTimezone=UTC
druid.username=your_username
druid.password=your_encrypted_password
druid.driverClassName=com.mysql.cj.jdbc.Driver

# Password Configuration
# druid.connectionProperties=config.decrypt=true;config.decrypt.key=your_key

# Connection Pool Configuration
druid.initialSize=5
druid.minIdle=5
druid.maxActive=20
druid.maxWait=60000
druid.timeBetweenEvictionRunsMillis=60000
druid.minEvictableIdleTimeMillis=300000
druid.validationQuery=SELECT 1
druid.testWhileIdle=true
druid.testOnBorrow=false
druid.testOnReturn=false
druid.poolPreparedStatements=true
druid.maxPoolPreparedStatementPerConnectionSize=20

# Configuration Center Settings
config.center.url=http://localhost:8080
config.center.directory=/druid/config
config.center.apiKey=your_api_key
config.center.configFile=druid.properties
