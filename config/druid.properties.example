# Druid JDBC Connection Pool Configuration - Example
# Copy this file to druid.properties and modify as needed

# ============================================
# Basic Configuration
# ============================================
driverClassName=com.mysql.cj.jdbc.Driver
url=jdbc:mysql://localhost:3306/test?useSSL=false&serverTimezone=UTC
username=root
password=[16]encoded_password_here

# ============================================
# Password Configuration
# ============================================
# Password decryption settings:
# - config.decrypt=true: Enable password decryption
# - config.decrypt.key: The encryption key used to decrypt the password
# - config.decrypt.algorithm: Encryption algorithm (AES or SM4)
druid.connectionProperties=config.decrypt=true;config.decrypt.key=your_encryption_key_here;config.decrypt.algorithm=AES

# ============================================
# Connection Pool Configuration
# ============================================
# Initial number of connections created when pool starts
initialSize=5

# Minimum number of idle connections to keep in pool
minIdle=5

# Maximum number of active connections in pool
maxActive=20

# Maximum time to wait for a connection (milliseconds)
maxWait=60000

# Time between eviction runs (milliseconds)
timeBetweenEvictionRunsMillis=60000

# Minimum idle time for a connection to be evicted (milliseconds)
minEvictableIdleTimeMillis=300000

# SQL query for validating connections
validationQuery=SELECT 1

# Test idle connections
testWhileIdle=true

# Test connection when borrowed from pool
testOnBorrow=false

# Test connection when returned to pool
testOnReturn=false

# Enable pooled prepared statements
poolPreparedStatements=true

# Maximum number of pooled prepared statements per connection
maxPoolPreparedStatementPerConnectionSize=20

# ============================================
# Configuration Center Integration
# ============================================
# Enable configuration center integration
config.center.enabled=true

# Configuration center URL
config.center.url=http://localhost:8080

# Configuration directory in config center
config.center.directory=/druid/config

# API key for config center authentication
config.center.apiKey=your_api_key_here

# Auto-refresh configuration from config center
config.center.autoRefresh=true

# Configuration refresh interval in seconds
config.center.refreshInterval=300

# ============================================
# Additional Configuration
# ============================================
# Connection properties (optional)
# connectionProperties=useUnicode=true;characterEncoding=utf8;

# Remove abandoned connections (optional)
# removeAbandoned=true
# removeAbandonedTimeout=1800
# logAbandoned=true

# Filters (optional)
# filters=stat,wall,log4j2
