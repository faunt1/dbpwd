<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
       http://www.springframework.org/schema/beans/spring-beans.xsd">

    <bean class="org.springframework.beans.factory.config.PropertyPlaceholderConfigurer">
        <property name="systemPropertiesModeName" value="SYSTEM_PROPERTIES_MODE_OVERRIDE"/>
        <property name="ignoreUnresolvablePlaceholders" value="true"/>
    </bean>

    <!--
        DataSourcePasswordProcessor: 自动解密DataSource密码
        这是Spring集成的核心组件，需要在DataSource之前声明
    -->
    <bean class="com.dbpwd.spring.DataSourcePasswordProcessor"/>

    <!--
        DataSource配置
        password设置为占位符，BeanPostProcessor会自动解密
    -->
    <bean id="dataSource" class="org.springframework.jdbc.datasource.DriverManagerDataSource">
        <property name="driverClassName" value="org.h2.Driver"/>
        <property name="url" value="jdbc:h2:file:${user.home}/.dbpwd/h2_data/dbpwd_spring_xml_demo;IFEXISTS=TRUE;MODE=MySQL"/>
        <property name="username" value="sa"/>
        <!--
            密码占位符: DataSourcePasswordProcessor会自动解密
            占位符格式: @db_name@
        -->
        <property name="password" value="@spring_demo_xml_db@"/>
    </bean>

    <!-- JdbcTemplate for database operations -->
    <bean id="jdbcTemplate" class="org.springframework.jdbc.core.JdbcTemplate">
        <property name="dataSource" ref="dataSource"/>
    </bean>

</beans>
