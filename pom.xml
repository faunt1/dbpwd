<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.dbpwd</groupId>
    <artifactId>db-pwd</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>

    <name>Database Password Manager</name>
    <description>Database password encryption and management tool, supporting SM4 algorithm and configuration center integration</description>

    <modules>
        <module>db-pwd-core</module>
        <module>db-pwd-druid</module>
        <module>db-pwd-spring</module>
        <module>db-pwd-spring-boot-starter</module>
        <module>db-pwd-mybatis</module>
        <module>db-pwd-web</module>
        <module>db-pwd-simple-jdbc-demo</module>
        <module>db-pwd-spring-boot-demo</module>
        <module>db-pwd-spring-demo</module>
        <module>db-pwd-struts-demo</module>
    </modules>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>1.8</maven.compiler.source>
        <maven.compiler.target>1.8</maven.compiler.target>
        <druid.version>1.2.20</druid.version>
        <hikaricp.version>4.0.3</hikaricp.version>
        <dbcp2.version>2.11.0</dbcp2.version>
        <c3p0.version>0.9.5.5</c3p0.version>
        <tomcat-jdbc.version>9.0.82</tomcat-jdbc.version>
        <commons-lang3.version>3.18.0</commons-lang3.version>
        <slf4j.version>1.7.36</slf4j.version>
        <logback.version>1.4.12</logback.version>
        <junit.version>5.9.3</junit.version>
        <spring-boot.version>2.7.18</spring-boot.version>
        <spring.framework.version>5.3.31</spring.framework.version>
    </properties>

    <repositories>
        <repository>
            <id>central</id>
            <name>Maven Central</name>
            <url>https://repo1.maven.org/maven2</url>
            <releases>
                <enabled>true</enabled>
            </releases>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </repository>
        <repository>
            <id>aliyun</id>
            <name>Aliyun Maven</name>
            <url>https://maven.aliyun.com/repository/public</url>
            <releases>
                <enabled>true</enabled>
            </releases>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </repository>
    </repositories>

    <pluginRepositories>
        <pluginRepository>
            <id>central</id>
            <name>Maven Central Plugin Repository</name>
            <url>https://repo1.maven.org/maven2</url>
            <releases>
                <enabled>true</enabled>
            </releases>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </pluginRepository>
        <pluginRepository>
            <id>aliyun</id>
            <name>Aliyun Maven Plugin Repository</name>
            <url>https://maven.aliyun.com/repository/public</url>
            <releases>
                <enabled>true</enabled>
            </releases>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </pluginRepository>
    </pluginRepositories>

    <build>
        <plugins>
            <!-- Maven Compiler Plugin -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.8.1</version>
                <configuration>
                    <source>1.8</source>
                    <target>1.8</target>
                    <encoding>UTF-8</encoding>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
